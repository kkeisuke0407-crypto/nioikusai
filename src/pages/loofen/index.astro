---
const SITE_NAME = "生ゴミ乾燥機えらび";
const PAGE_TITLE = "生ゴミ処理機はいらない？後悔する人・買ってよかった人の違い";
const FULL_TITLE = `${PAGE_TITLE}｜生ゴミ乾燥機えらび`;
const PAGE_DESC =
  "生ゴミ処理機や生ゴミ乾燥機を買う前に、いらない人・向いている人、乾燥式・コンポスト・バイオ式の違い、Loofenの特徴と注意点を確認できます。";
const SITE_URL = import.meta.env.PUBLIC_LOOFEN_SITE_URL ?? "https://loofen.hakobu-family.com";
const BASE_PATH = "/loofen";
const CANONICAL = `${SITE_URL}${BASE_PATH}`;
const OGP_IMAGE = `${SITE_URL}${BASE_PATH}/product-white-official.webp`;
const AFFILIATE_URL = "https://loofen.jp/";
const UPDATED_AT = "2026年5月27日";

const comparisonRows = [
  {
    type: "乾燥式",
    fit: "室内で臭い・コバエ・ゴミの重さを減らしたい人",
    strong: "水分を飛ばして量と臭いの元を減らしやすい",
    caution: "本体価格、電気代、フィルターなどの消耗品を確認"
  },
  {
    type: "コンポスト",
    fit: "庭やベランダで堆肥化したい人",
    strong: "電気代がかかりにくく、土づくりに使える",
    caution: "設置場所、虫、混ぜる手間、季節差が出やすい"
  },
  {
    type: "バイオ式",
    fit: "分解処理を任せたい人、処理量が多い家庭",
    strong: "微生物で分解するため、家庭の運用に合えば便利",
    caution: "チップ交換、湿度管理、設置場所を事前に確認"
  },
  {
    type: "冷凍・密閉ゴミ箱",
    fit: "購入費を抑えたい人、まず臭いだけ抑えたい人",
    strong: "導入しやすく、短期的な臭い対策になる",
    caution: "ゴミ量は減りにくく、捨てる手間は残りやすい"
  }
];

const concernItems = [
  "生ゴミの臭いを夏前にどうにかしたい",
  "コバエ対策を毎年くり返したくない",
  "コンポストの虫・土管理は避けたい",
  "生ゴミ処理機が本当に必要か先に知りたい",
  "乾燥式の費用や消耗品まで見て判断したい",
  "公式サイトへ行く前に注意点を整理したい"
];

const buyingChecks = [
  {
    label: "設置寸法",
    value: "フィルター込み奥行き380mm",
    detail: "本体寸法だけでなく、公式掲載のフィルター込み寸法まで測っておくと置き場所で失敗しにくくなります。"
  },
  {
    label: "送料",
    value: "全国一律税込1,320円",
    detail: "沖縄・離島は別途案内の可能性があります。購入直前に合計金額を確認してください。"
  },
  {
    label: "返品",
    value: "お客様都合は原則不可",
    detail: "注文完了後のお客様都合による返品・交換・返金は承っていない旨が公式に掲載されています。"
  },
  {
    label: "消耗品",
    value: "フィルター等を確認",
    detail: "活性炭フィルターやバスケットカバーなど、購入後に必要なものと交換頻度を確認します。"
  }
];

const reviewInsights = [
  {
    stat: "35 / 92",
    title: "臭い・においへの言及",
    detail: "提供されたレビュー自由記述では、臭い・においに触れた回答が35件ありました。"
  },
  {
    stat: "45 / 92",
    title: "楽さ・簡単さへの言及",
    detail: "楽さ・手間・操作の簡単さに触れた回答は45件。毎日続けられるかは確認したい軸です。"
  },
  {
    stat: "店頭ログ",
    title: "購入前は費用も確認",
    detail: "提供された接客ログでは、置き場所に加えて専用袋やフィルターなど継続費を気にする会話が確認できました。"
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "生ゴミ処理機はいらない人はどんな人ですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ゴミ出し頻度が高く、生ゴミの臭いやコバエに困っていない人、設置スペースや消耗品コストを増やしたくない人は急いで買う必要はありません。まずは密閉ゴミ箱や水切りなどで十分か確認すると判断しやすくなります。"
      }
    },
    {
      "@type": "Question",
      "name": "乾燥式の生ゴミ処理機は何が便利ですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "生ゴミの水分を乾燥させることで、重さや臭いの元を減らしやすい点が便利です。室内で使いやすい一方、本体価格、電気代、フィルターなどの消耗品は事前に確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "Loofenはどんな人に向いていますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "キッチンに置けるサイズ感、乾燥式、活性炭フィルター、5L容量などを重視し、臭い・コバエ・ゴミの重さを減らしたい家庭に向いています。最新の価格、キャンペーン、返品条件、送料は公式サイトで確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "60日間返金保証があれば返品できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "公式サイトには60日間返金保証の表示がありますが、注文完了後のお客様都合による返品・交換・返金は承っていない旨も掲載されています。適用条件は購入前に公式サイトで確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "このページは公式サイトですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "公式サイトではありません。広告を含む判断支援ページです。購入価格、保証、返品、送料、キャンペーンの最終条件は遷移先の公式サイトで確認してください。"
      }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{FULL_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={CANONICAL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${PAGE_TITLE}｜${SITE_NAME}`} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:url" content={CANONICAL} />
  <meta property="og:image" content={OGP_IMAGE} />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/loofen/styles.css" />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18129603657"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-18129603657');
  </script>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/loofen" aria-label={SITE_NAME}>
        <span class="brand-mark">乾</span>
        <span>{SITE_NAME}</span>
      </a>
      <nav class="nav" aria-label="ページ内ナビゲーション">
        <a href="#need">必要性</a>
        <a href="#compare">方式比較</a>
        <a href="#loofen">候補</a>
        <a href="#faq">FAQ</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">PR｜夏のキッチン監査レポート</p>
          <div class="mobile-signal" aria-hidden="true">
            <span class="device-picto"></span>
            <span>乾燥式を候補にする前の確認</span>
          </div>
          <img
            class="mobile-hero-photo product-photo"
            src="/loofen/product-white-official.webp"
            width="890"
            height="892"
            alt="Loofen生ゴミ乾燥機のホワイト本体"
            decoding="async"
          />
          <p class="mobile-image-note">商品画像：公式サイト掲載素材</p>
          <h1>生ゴミ処理機、<br />本当にいらない？</h1>
          <p class="hero-lead">
            「便利そうだけど高い」「結局使わないかも」。そう迷っている人向けに、
            いらないケース、買ってよかったと感じやすいケース、乾燥式を選ぶ理由を先に整理しました。
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#need">向き不向きを確認</a>
            <a class="btn btn-secondary" href="#loofen">乾燥式の候補を見る</a>
          </div>
          <p class="microcopy">広告を含む比較・判断支援ページです。最終条件は公式サイトで確認してください。</p>
          <div class="trust-strip" aria-label="掲載情報の確認事項">
            <span>PR表記あり</span>
            <span>公式情報を確認</span>
            <span>{UPDATED_AT}更新</span>
          </div>
          <ul class="hero-points">
            <li><span>01</span> 臭い・コバエ対策の優先度</li>
            <li><span>02</span> 乾燥式とコンポストの違い</li>
            <li><span>03</span> 買って後悔しやすい条件</li>
            <li><span>04</span> 購入前に見る費用と保証</li>
          </ul>
        </div>
        <div class="hero-art" aria-label="キッチン診断パネル">
          <div class="audit-card">
            <span>Kitchen waste audit</span>
            <strong>水分・臭い・置き場所</strong>
            <p>3つの負担が重なったら、乾燥式を検討する価値があります。</p>
          </div>
          <img
            class="product-photo"
            src="/loofen/product-white-official.webp"
            width="890"
            height="892"
            alt="Loofen生ゴミ乾燥機のホワイト本体"
            decoding="async"
            fetchpriority="high"
          />
          <p class="image-note">商品画像：公式サイト掲載素材</p>
          <div class="floating-note">
            <strong>臭い・重さ・虫</strong>
            <span>夏のキッチンでつらくなる前に、必要性をチェック</span>
          </div>
        </div>
      </div>
    </section>

    <div class="notice">
      <div class="container">
        <p>このページは広告を含みます。掲載情報は{UPDATED_AT}時点で公式サイト等を確認した内容をもとに作成しています。</p>
      </div>
    </div>

    <section id="need">
      <div class="container split">
        <div class="section-head">
          <span class="section-label">AUDIT 01</span>
          <h2>まず「買わなくていい人」から確認する</h2>
          <p class="lead">
            生ゴミ処理機は全員に必要な家電ではありません。先に不要なケースを切り分けると、広告に流されず判断できます。
          </p>
        </div>
        <div class="panel panel-pad">
          <ul class="check-list">
            <li>週2回以上のゴミ出しで、生ゴミを長く置かない</li>
            <li>臭いは密閉ゴミ箱・冷凍・水切りで十分に抑えられている</li>
            <li>キッチンに幅27cm前後の家電を置く余白がない</li>
            <li>フィルター交換やバスケットカバーなどの消耗品を増やしたくない</li>
            <li>堆肥化したい目的が強く、庭や土の管理に抵抗がない</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="container">
        <div class="section-head">
          <span class="section-label">AUDIT 02</span>
          <h2>それでも乾燥式が候補になるのは、悩みが「水分」に寄っているとき</h2>
          <p class="lead">
            生ゴミの重さ、臭い、コバエは水分が残るほどつらくなります。乾燥式はそこに直接アプローチする選択肢です。
          </p>
        </div>
        <div class="decision-grid">
          <div class="decision">
            <h3>買ってよかったと感じやすい人</h3>
            <ul>
              <li>夏場の臭い・コバエが毎年ストレス</li>
              <li>料理後の生ゴミが重く、ゴミ出しがつらい</li>
              <li>室内で完結する処理方法を探している</li>
              <li>コンポストの土管理や虫が苦手</li>
            </ul>
          </div>
          <div class="decision">
            <h3>後悔しやすい人</h3>
            <ul>
              <li>本体価格だけ見て、送料・消耗品を見ていない</li>
              <li>乾燥にかかる時間や音の感じ方を確認していない</li>
              <li>設置寸法を測らずに購入する</li>
              <li>自治体の助成金を調べずに急いで買う</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="evidence">
      <div class="container">
        <div class="section-head">
          <span class="section-label">PROVIDED DATA</span>
          <h2>レビューと店頭ログから、確認ポイントを絞る</h2>
          <p class="lead">
            提供されたレビュー自由記述92件と店頭接客ログを確認。良い面だけでなく、購入前に確かめたい不安も残します。
          </p>
        </div>
        <div class="insight-grid">
          {reviewInsights.map((item) => (
            <article class="insight">
              <strong>{item.stat}</strong>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
        <p class="research-note">
          出典：提供資料「loofenレビュー.xlsx」「蔦屋家電_接客ログ.xlsx」を当サイトで集計・要約。個人の感想を含み、効果や満足度を保証するものではありません。
        </p>
      </div>
    </section>

    <section id="compare">
      <div class="container">
        <div class="section-head">
          <span class="section-label">AUDIT 03</span>
          <h2>生ゴミ処理の選択肢をざっくり比較</h2>
          <p class="lead">
            「おすすめ」だけで決めるより、処理方式ごとの得意・不得意を見る方が失敗しにくいです。
          </p>
        </div>
        <div class="compare-wrap">
          <table>
            <thead>
              <tr>
                <th>方式</th>
                <th>向いている人</th>
                <th>強み</th>
                <th>注意点</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr>
                  <td><strong>{row.type}</strong></td>
                  <td>{row.fit}</td>
                  <td>{row.strong}</td>
                  <td>{row.caution}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="keyword-box">
          <strong>このページが向いている悩み</strong>
          <ul>
            {concernItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <div class="section-head">
          <span class="section-label">CHECKPOINT</span>
          <h2>乾燥式を選ぶなら、見るべきポイントは3つ</h2>
        </div>
        <div class="three-grid">
          <article class="reason-card">
            <span>1</span>
            <h3>水分をどれだけ減らせるか</h3>
            <p>生ゴミは水分が残るほど重く、臭いも出やすくなります。削減率や乾燥後の扱いを確認します。</p>
          </article>
          <article class="reason-card">
            <span>2</span>
            <h3>室内で続けられるか</h3>
            <p>サイズ、音、電気代、追加投入のしやすさは毎日の使い勝手に直結します。</p>
          </article>
          <article class="reason-card">
            <span>3</span>
            <h3>購入後コストが読めるか</h3>
            <p>送料、保証、返金条件、フィルター交換頻度、バスケットカバーの価格まで見ます。</p>
          </article>
        </div>
      </div>
    </section>

    <section id="loofen" class="offer">
      <div class="container">
        <div class="section-head">
          <span class="section-label">DRYER CANDIDATE</span>
          <h2>乾燥式で候補に入るLoofen</h2>
          <p class="lead">
            Loofenは乾燥式の生ゴミ乾燥機。公式サイトでは、生ゴミ77%削減、5L容量、活性炭フィルター、60日間返金保証などが案内されています。
          </p>
        </div>
        <article class="offer-card">
          <div class="offer-visual">
            <img
              src="/loofen/product-white-official.webp"
              width="890"
              height="892"
              alt="Loofen生ゴミ乾燥機のホワイト本体"
              loading="lazy"
              decoding="async"
            />
            <p>商品画像：公式サイト掲載素材</p>
          </div>
          <div class="offer-body">
            <h3>Loofen SLW01を確認する前に見るポイント</h3>
            <p class="lead">
              公式のキャンペーンや分割価格は時期で変わる可能性があります。購入前は、価格・送料・保証・返品条件・消耗品をまとめて確認してください。
            </p>
            <div class="fact-grid">
              <div class="fact">
                <strong>乾燥式</strong>
                <span>温風空気循環乾燥方式</span>
              </div>
              <div class="fact">
                <strong>5L</strong>
                <span>公式掲載の容量</span>
              </div>
              <div class="fact">
                <strong>約6kg</strong>
                <span>公式掲載の本体重量</span>
              </div>
              <div class="fact">
                <strong>幅270mm</strong>
                <span>本体寸法の目安</span>
              </div>
            </div>
            <p class="note">
              2026年5月27日時点の公式サイトでは、10,000円オフクーポン、WEB限定特典、60日間返金保証、1年間保証などの表示があります。適用条件と最新内容は遷移先で確認してください。
            </p>
            <div class="source-note">
              <strong>公式情報で確認したい条件</strong>
              <span>寸法、送料、返品条件、消耗品、キャンペーン適用条件は購入直前に公式サイトの表示を優先してください。</span>
            </div>
            <div class="cta-row">
              <a class="btn btn-primary js-affiliate" href={AFFILIATE_URL} rel="nofollow sponsored" data-track="loofen_offer_cta">Loofenの最新条件を確認</a>
              <a class="btn btn-secondary" href="#faq">購入前の疑問を見る</a>
            </div>
            <p class="microcopy">このページはLoofen公式サイトではありません。購入や保証の条件は公式サイトの表示が優先されます。</p>
          </div>
        </article>
      </div>
    </section>

    <section>
      <div class="container">
        <div class="section-head">
          <span class="section-label">BEFORE BUYING</span>
          <h2>購入前の確認はこの順番で十分</h2>
        </div>
        <div class="buying-grid">
          {buyingChecks.map((item) => (
            <article class="buying-check">
              <span>{item.label}</span>
              <h3>{item.value}</h3>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="faq">
      <div class="container">
        <div class="section-head">
          <span class="section-label">FAQ</span>
          <h2>よくある疑問</h2>
        </div>
        <div class="faq-grid">
          <article class="faq-item">
            <h3>生ゴミ処理機は本当に必要ですか？</h3>
            <p>臭い・コバエ・ゴミの重さに困っていないなら急ぐ必要はありません。困りごとが夏場に集中するなら、乾燥式は候補になります。</p>
          </article>
          <article class="faq-item">
            <h3>乾燥後のゴミはどうしますか？</h3>
            <p>公式FAQでは、自治体ルールに従って可燃ゴミとして捨てる、または土に埋めて堆肥として使えると説明されています。</p>
          </article>
          <article class="faq-item">
            <h3>消耗品はありますか？</h3>
