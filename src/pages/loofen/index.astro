---
const SITE_NAME = "生ゴミ乾燥機えらび";
const PAGE_TITLE = "生ゴミ処理機はいらない？Loofenの口コミ・使い方と購入前の注意点";
const FULL_TITLE = `${PAGE_TITLE}｜生ゴミ乾燥機えらび`;
const PAGE_DESC =
  "Loofen生ゴミ乾燥機の使い方、購入者レビュー、サイズや消耗品など購入前に確認したい点を紹介します。";
const SITE_URL = import.meta.env.PUBLIC_LOOFEN_SITE_URL ?? "https://loofen.hakobu-family.com";
const BASE_PATH = "/loofen";
const CANONICAL = `${SITE_URL}${BASE_PATH}`;
const OGP_IMAGE = `${SITE_URL}${BASE_PATH}/product-white-official.webp`;
const ASSET_VERSION = "20260527-3";
const AFFILIATE_URL = "https://loofen.jp/";
const UPDATED_AT = "2026年5月27日";

const comparisonRows = [
  {
    type: "乾燥式",
    fit: "室内で臭い・コバエ・ゴミの重さを減らしたい人",
    strong: "水分を飛ばして量と臭いの元を減らしやすい",
    caution: "本体価格、電気代、フィルターなどの消耗品を確認"
  },
  {
    type: "コンポスト",
    fit: "庭やベランダで堆肥化したい人",
    strong: "電気代がかかりにくく、土づくりに使える",
    caution: "設置場所、虫、混ぜる手間、季節差が出やすい"
  },
  {
    type: "バイオ式",
    fit: "分解処理を任せたい人、処理量が多い家庭",
    strong: "微生物で分解するため、家庭の運用に合えば便利",
    caution: "チップ交換、湿度管理、設置場所を事前に確認"
  },
  {
    type: "冷凍・密閉ゴミ箱",
    fit: "購入費を抑えたい人、まず臭いだけ抑えたい人",
    strong: "導入しやすく、短期的な臭い対策になる",
    caution: "ゴミ量は減りにくく、捨てる手間は残りやすい"
  }
];

const concernItems = [
  "生ゴミを捨てる日まで置いておくと、においが気になる",
  "暑い時期のコバエや液だれを減らしたい",
  "料理中に出る皮や食べ残しをすぐ片づけたい",
  "コンポストより、室内で手軽に使える方法を探している"
];

const buyingChecks = [
  {
    label: "置き場所",
    value: "フィルター込み奥行き38cm",
    detail: "本体は幅27 × 奥行27.5 × 高さ35cm。背面のフィルターを含めると奥行きは38cmです。"
  },
  {
    label: "消耗品",
    value: "フィルター交換あり",
    detail: "活性炭フィルターやバスケットカバーなど、使い続けるための消耗品があります。"
  },
  {
    label: "助成金",
    value: "対象になる自治体も",
    detail: "自治体によって、生ゴミ処理機の購入費補助を利用できる場合があります。"
  },
  {
    label: "保証・返品",
    value: "条件を注文前に確認",
    detail: "返金保証やキャンペーンの適用条件は、購入画面で確認してから注文しましょう。"
  }
];

const customerReviews = [
  {
    title: "初めての生ゴミ処理機!!",
    quote: "早速使ってみました！本当にパリパリになりました。これからの季節、虫とか臭いが気になるので助かります！",
    color: "ホワイト"
  },
  {
    title: "暑くなる時期に...",
    quote: "思った以上に簡単で、処理もスムーズ。今まで苦痛だった臭いからすると、全然気が楽になります。",
    color: "ピンク"
  },
  {
    title: "買ってよかった",
    quote: "まず、ストレスがかなり軽減されました！むしろ三角コーナーがいらなくなったので、水回りがいつも清潔で気持ちがいいです。",
    color: "ホワイト"
  },
  {
    title: "画期的な家庭用ごみ処理器",
    quote: "使い方はワンタッチで簡単。強力乾燥してくれます。",
    color: "ピンク"
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "生ゴミ処理機はいらない人はどんな人ですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ゴミ出し頻度が高く、生ゴミの臭いやコバエに困っていない人、設置スペースや消耗品コストを増やしたくない人は急いで買う必要はありません。まずは密閉ゴミ箱や水切りなどで十分か確認すると判断しやすくなります。"
      }
    },
    {
      "@type": "Question",
      "name": "乾燥式の生ゴミ処理機は何が便利ですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "生ゴミの水分を乾燥させることで、重さや臭いの元を減らしやすい点が便利です。室内で使いやすい一方、本体価格、電気代、フィルターなどの消耗品は事前に確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "Loofenはどんな人に向いていますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "キッチンに置けるサイズ感、乾燥式、活性炭フィルター、5L容量などを重視し、臭い・コバエ・ゴミの重さを減らしたい家庭に向いています。最新の価格、キャンペーン、返品条件、送料は公式サイトで確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "60日間返金保証があれば返品できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "公式サイトには60日間返金保証の表示がありますが、注文完了後のお客様都合による返品・交換・返金は承っていない旨も掲載されています。適用条件は購入前に公式サイトで確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "助成金は使えますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "自治体によっては、生ゴミ処理機が助成金の対象になります。お住まいの地域の制度をご確認ください。"
      }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{FULL_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={CANONICAL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${PAGE_TITLE}｜${SITE_NAME}`} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:url" content={CANONICAL} />
  <meta property="og:image" content={OGP_IMAGE} />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href={`/loofen/styles.css?v=${ASSET_VERSION}`} />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18129603657"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-18129603657');
  </script>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/loofen" aria-label={SITE_NAME}>
        <span class="brand-mark">乾</span>
        <span>{SITE_NAME}</span>
      </a>
      <nav class="nav" aria-label="ページ内ナビゲーション">
        <a href="#use">使い方</a>
        <a href="#reviews">口コミ</a>
        <a href="#loofen">商品情報</a>
        <a href="#faq">よくある質問</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">PR｜Loofen 生ゴミ乾燥機</p>
          <img
            class="mobile-hero-photo lifestyle-hero"
            src="/loofen/media/colors-kitchen.webp"
            width="900"
            height="1200"
            alt="キッチンカウンターに並ぶLoofen生ゴミ乾燥機の3色"
            decoding="async"
          />
          <h1>生ゴミのにおい、<br />もう我慢しない。</h1>
          <p class="hero-lead">
            料理で出た生ゴミを入れて、ボタンを押すだけ。
            乾燥して量を減らし、においやコバエの悩みを軽くするLoofenを紹介します。
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#loofen">商品情報を見る</a>
            <a class="btn btn-secondary" href="#reviews">口コミを見る</a>
          </div>
        </div>
        <div class="hero-art" aria-label="Loofenのキッチン設置イメージ">
          <img
            class="lifestyle-hero"
            src="/loofen/media/colors-kitchen.webp"
            width="900"
            height="1200"
            alt="キッチンカウンターに並ぶLoofen生ゴミ乾燥機の3色"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <div class="notice">
      <div class="container">
        <p>PR　このページは広告を含みます。</p>
      </div>
    </div>

    <section id="need">
      <div class="container split">
        <div class="section-head">
          <span class="section-label">こんなご家庭に</span>
          <h2>生ゴミを置いておく時間が、つらくなってきたら。</h2>
          <p class="lead">
            暑くなると、三角コーナーやゴミ箱のにおいは気になりやすいもの。次のような悩みがあるなら、乾燥式を考える理由があります。
          </p>
        </div>
        <div class="panel panel-pad">
          <ul class="check-list">
            {concernItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="container">
        <div class="section-head">
          <span class="section-label">選ぶ前に</span>
          <h2>便利そう、だけで決めないために。</h2>
          <p class="lead">
            乾燥式が合う家庭もあれば、密閉ゴミ箱やこまめなゴミ出しで十分な家庭もあります。
          </p>
        </div>
        <div class="decision-grid">
          <div class="decision">
            <h3>Loofenを検討しやすい人</h3>
            <ul>
              <li>生ゴミのにおい・コバエが気になる</li>
              <li>料理後にすぐ投入できる家電がほしい</li>
              <li>キッチンの中で処理を完結させたい</li>
            </ul>
          </div>
          <div class="decision">
            <h3>先に確認しておきたい人</h3>
            <ul>
              <li>本体とフィルター込みの奥行きが置けるか不安</li>
              <li>フィルターなどの消耗品が気になる</li>
              <li>自治体の助成金対象か調べてから買いたい</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="use" class="daily-use">
      <div class="container">
        <div class="section-head">
          <span class="section-label">使い方</span>
          <h2>入れて、乾燥。片づけはバスケットを洗うだけ。</h2>
          <p class="lead">
            料理中に出た皮や切れ端をそのまま投入。運転中でも生ゴミを追加できます。
          </p>
        </div>
        <div class="use-gallery">
          <figure class="use-scene use-scene-main">
            <img src="/loofen/media/prep-white.webp" width="1100" height="619" alt="料理中の野菜くずをLoofenの白いバスケットへ入れる様子" loading="lazy" decoding="async" />
            <figcaption><strong>料理中に投入</strong><span>皮や切れ端を、そのままバスケットへ。</span></figcaption>
          </figure>
          <figure class="use-scene">
            <img src="/loofen/media/prep-black.webp" width="533" height="800" alt="黒いLoofenのバスケットへ生ゴミを入れる様子" loading="lazy" decoding="async" />
            <figcaption><strong>置きやすいデザイン</strong><span>キッチンに出したまま使える3色展開。</span></figcaption>
          </figure>
          <figure class="use-scene">
            <img src="/loofen/media/basket-rinse.webp" width="1100" height="619" alt="Loofenのバスケットをシンクで水洗いする様子" loading="lazy" decoding="async" />
            <figcaption><strong>お手入れ</strong><span>バスケットは取り外して水洗いできます。</span></figcaption>
          </figure>
        </div>
        <div class="video-check">
          <div class="video-copy">
            <span class="section-label">動画で見る</span>
            <h3>キッチンに置いたサイズ感</h3>
            <p>戸棚や家電の隣に置いたときの雰囲気を、動画で見られます。</p>
          </div>
          <video controls muted playsinline preload="metadata" poster="/loofen/media/daily-use-poster.webp" aria-label="Loofenの設置イメージ動画">
            <source src="/loofen/media/daily-use-demo.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </section>

    <section id="reviews" class="evidence reviews">
      <div class="container">
        <div class="section-head">
          <span class="section-label">購入者レビュー</span>
          <h2>使った人が感じた、においと手間の変化。</h2>
          <p class="lead">
            Amazonで購入した方のレビューから、一部を抜粋して紹介します。
          </p>
        </div>
        <div class="review-grid">
          {customerReviews.map((item) => (
            <article class="review-card">
              <p class="review-stars" aria-label="星5つ">★★★★★ <span>Amazonで購入</span></p>
              <h3>{item.title}</h3>
              <blockquote>{item.quote}</blockquote>
              <p class="review-color">購入カラー：{item.color}</p>
            </article>
          ))}
        </div>
        <p class="review-note">Amazon購入者レビューより抜粋。個人の感想であり、使用感には個人差があります。</p>
      </div>
    </section>

    <section id="compare">
      <div class="container">
        <div class="section-head">
          <span class="section-label">ほかの方法との違い</span>
          <h2>乾燥式が合うか、比べてみる。</h2>
          <p class="lead">
            手軽さを重視するのか、堆肥化したいのか。暮らしに合う方法は家庭によって違います。
          </p>
        </div>
        <div class="compare-wrap">
          <table>
            <thead>
              <tr>
                <th>方式</th>
                <th>向いている人</th>
                <th>強み</th>
                <th>注意点</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr>
                  <td><strong>{row.type}</strong></td>
                  <td>{row.fit}</td>
                  <td>{row.strong}</td>
                  <td>{row.caution}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <div class="section-head">
          <span class="section-label">Loofenの特徴</span>
          <h2>毎日使うための、シンプルな機能。</h2>
        </div>
        <div class="three-grid">
          <article class="reason-card">
            <span>1</span>
            <h3>生ゴミを乾燥して77%削減</h3>
            <p>水分の多い生ゴミを乾燥させて、ゴミのかさと重さを減らします。</p>
          </article>
          <article class="reason-card">
            <span>2</span>
            <h3>ワンタッチで操作</h3>
            <p>生ゴミを入れて電源を入れるだけ。運転中の追加投入にも対応しています。</p>
          </article>
          <article class="reason-card">
            <span>3</span>
            <h3>活性炭フィルターでにおい対策</h3>
            <p>キッチンで使うことを考えた、活性炭フィルターを採用しています。</p>
          </article>
        </div>
      </div>
    </section>

    <section id="loofen" class="offer">
      <div class="container">
        <div class="section-head">
          <span class="section-label">商品情報</span>
          <h2>Loofen 生ゴミ乾燥機</h2>
          <p class="lead">
            料理中に出た生ゴミを入れて使える、キッチン向けの乾燥式処理機です。
          </p>
        </div>
        <div class="official-proof" aria-label="Loofen公式掲載の主な特徴">
          <div><strong>世界130万台</strong><span>販売実績</span></div>
          <div><strong>77%削減</strong><span>生ゴミを乾燥</span></div>
          <div><strong>5L</strong><span>バスケット容量</span></div>
          <div><strong>3色</strong><span>カラー展開</span></div>
        </div>
        <p class="proof-note">※販売実績・削減率・仕様はメーカー掲載情報によります。削減率は処理する生ゴミにより異なります。</p>
        <article class="offer-card">
          <div class="offer-visual">
            <img
              src="/loofen/media/product-charcoal.webp"
              width="960"
              height="1146"
              alt="Loofen生ゴミ乾燥機のチャコール本体"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="offer-body">
            <h3>いま購入前に確認できる内容</h3>
            <p class="lead">
              公式サイトでは、クーポンや返金保証、自治体の助成金案内を確認できます。
            </p>
            <div class="fact-grid">
              <div class="fact">
                <strong>乾燥式</strong>
                <span>温風空気循環乾燥</span>
              </div>
              <div class="fact">
                <strong>5L</strong>
                <span>バスケット容量</span>
              </div>
              <div class="fact">
                <strong>約6kg</strong>
                <span>本体重量</span>
              </div>
              <div class="fact">
                <strong>幅270mm</strong>
                <span>本体幅</span>
              </div>
            </div>
            <p class="note">
              現在、公式サイトでは10,000円OFFクーポンと60日間返金保証が案内されています。適用条件は購入前にご確認ください。
            </p>
            <div class="cta-row">
              <a class="btn btn-primary js-affiliate" href={AFFILIATE_URL} rel="nofollow sponsored" data-track="loofen_offer_cta">クーポン・価格を確認する</a>
              <a class="btn btn-secondary" href="#faq">よくある質問</a>
            </div>
            <p class="microcopy">※価格・キャンペーン情報は{UPDATED_AT}確認。最新内容は遷移先でご確認ください。</p>
          </div>
        </article>
      </div>
    </section>

    <section>
      <div class="container">
        <div class="section-head">
          <span class="section-label">購入前に</span>
          <h2>置き場所と条件を、最後に確認。</h2>
        </div>
        <div class="buying-grid">
          {buyingChecks.map((item) => (
            <article class="buying-check">
              <span>{item.label}</span>
              <h3>{item.value}</h3>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="faq">
      <div class="container">
        <div class="section-head">
          <span class="section-label">よくある質問</span>
          <h2>購入前に気になること</h2>
        </div>
        <div class="faq-grid">
          <article class="faq-item">
            <h3>生ゴミ処理機は本当に必要ですか？</h3>
            <p>臭い・コバエ・ゴミの重さに困っていないなら急ぐ必要はありません。困りごとが夏場に集中するなら、乾燥式は候補になります。</p>
          </article>
          <article class="faq-item">
            <h3>乾燥後のゴミはどうしますか？</h3>
            <p>乾燥後は、自治体のルールに従って可燃ゴミとして捨てられます。土に埋めて堆肥として使う方法も案内されています。</p>
          </article>
          <article class="faq-item">
            <h3>消耗品はありますか？</h3>
            <p>活性炭フィルターやバスケットカバーがあります。フィルター交換の目安は、使い方により3〜6か月程度です。</p>
          </article>
          <article class="faq-item">
            <h3>60日間返金保証があれば返品できますか？</h3>
            <p>60日間返金保証には適用条件があります。注文後の返品条件とあわせて、購入前に公式サイトでご確認ください。</p>
          </article>
          <article class="faq-item">
            <h3>助成金は使えますか？</h3>
            <p>自治体によっては、生ゴミ処理機が助成金の対象になります。お住まいの地域の制度をご確認ください。</p>
          </article>
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="container">
        <h2>においを気にする毎日を、少しラクに。</h2>
        <p>
          Loofenの価格、クーポン、助成金の対象状況を確認して、暮らしに合うか見てみましょう。
        </p>
        <div class="cta-row" style="justify-content:center">
          <a class="btn btn-primary js-affiliate" href={AFFILIATE_URL} rel="nofollow sponsored" data-track="final_cta">クーポン・価格を確認する</a>
        </div>
      </div>
    </section>
  </main>

  <div class="sticky-cta" aria-label="固定CTA">
    <div class="container sticky-inner">
      <p>Loofenの価格・クーポンを確認</p>
      <a class="btn btn-primary js-affiliate" href={AFFILIATE_URL} rel="nofollow sponsored" data-track="sticky_cta">確認する</a>
    </div>
  </div>

  <footer class="footer">
    <div class="container">
      <div class="footer-links">
        <a href="/loofen/disclosure">広告掲載について</a>
        <a href="/loofen/operator">運営者情報</a>
        <a href="/loofen/privacy">プライバシーポリシー</a>
      </div>
      <p>© {new Date().getFullYear()} {SITE_NAME}. 当サイトは公式サイトではありません。最新の販売条件は遷移先でご確認ください。</p>
    </div>
  </footer>

  <script is:inline>
    document.querySelectorAll(".js-affiliate").forEach((link) => {
      link.addEventListener("click", () => {
        if (typeof window.gtag === "function") {
          window.gtag("event", "affiliate_click", {
            event_category: "loofen",
            event_label: link.dataset.track || "cta"
          });
        }
      });
    });

    const stickyCta = document.querySelector(".sticky-cta");
    const hero = document.querySelector(".hero");
    if (stickyCta && hero && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver(([entry]) => {
        stickyCta.classList.toggle("is-visible", entry.intersectionRatio < 0.2);
      }, { threshold: [0, 0.2] });
      observer.observe(hero);
    } else if (stickyCta) {
      stickyCta.classList.add("is-visible");
    }
  </script>
</body>
</html>
